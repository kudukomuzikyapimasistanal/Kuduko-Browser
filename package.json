{
  "name": "kuduko",
  "version": "1.0.0",
  "description": "Kuduko - Müzik yapımı yerleşik tarayıcı",
  "main": "src/main.js",
  "author": "Kuduko",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable nsis",
    "pack": "electron-packager . Kuduko --platform=win32 --arch=x64 --out=dist-exe --overwrite --ignore=\"^/dist\""
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.kuduko.browser",
    "productName": "Kuduko",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "forceCodeSigning": false
  }
}